{:paths ["src"]
 :deps {
        ;; kotoba.bytes replaced UTF-8 .getBytes / String. here (2026-09-24). An explicit
        ;; floor: tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/bytes {:git/sha "d5259f35ab7c4f5a66e63ca29ed4dcf7ba3f1ac5"}
        ;; kotoba.io replaced clojure.java.io / java.io.File here (2026-09-24).
        ;; An explicit floor: the java.io.File method functions (exists?, file?,
        ;; parent-file, canonical-path, mkdirs, list-files ...) are in kotoba.io
        ;; from this sha, and tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/io {:git/sha "1b60ca825c1e705bd195f857ca4549133653a9f3"}
        ;; kotoba.json replaced clojure.data.json here (2026-09-24). An explicit
        ;; floor: kotoba.json/read-str and /write-str first exist at 9c11ad1, and
        ;; tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/json {:git/sha "9c11ad189e64907700e8b4eb9b26f40336bffa01"}
        ;; kotoba.lang.edn replaced clojure.edn here (2026-09-23). An explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, and kbb resolves git deps
        ;; only from nbb.edn, so every project file this repo has names it.
        io.github.kotoba-lang/edn {:git/sha "79dba32c8892058842c57783f06a2dfe4601aeb0"}
       ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test {:git/url "https://github.com/kotoba-lang/test.git"
                                    :git/sha "2ab4885f99fd25552d380d0f6b0b54c5a72eb7ae"}
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/jp-go-digital-design-system
        {:git/url "https://github.com/kotoba-lang/jp-go-digital-design-system"
         :git/sha "83db99546eabc53613ae826ea41d1533a3c574af"}
io.github.kotoba-lang/langgraph
        {:local/root "../../kotoba-lang/langgraph"}
        io.github.kotoba-lang/langchain-store
        {:local/root "../../kotoba-lang/langchain-store"}
        io.github.kotoba-lang/crm
        {:local/root "../../kotoba-lang/crm"}
        ;; HTTP service layer (src/marketing/http.cljk, JVM-only compat
        ;; glue — see its ns docstring for why this is not a .cljc
        ;; violation). Same versions as cloud-itonami-isic-5820's
        ;; src/crm/http.clj.
        http-kit/http-kit        {:mvn/version "2.8.1"}
        ring/ring-core           {:mvn/version "1.15.3"}
        org.clojure/data.json    {:mvn/version "2.5.2"}}
 :aliases
 {:dev {:override-deps
        {io.github.kotoba-lang/langchain
         {:local/root "../../kotoba-lang/langchain"}}}
  :run {:main-opts ["-m" "marketing.sim"]}
  ;; kbb -M:serve → starts the real HTTP service (src/marketing/http.cljk).
  ;; Port: $ISIC6201_HTTP_PORT (default 8080). Auth: $ISIC6201_API_TOKEN
  ;; MUST be set (fail-closed — see docs/api.md).
  :serve {:main-opts ["-m" "marketing.http"]}
  ;; kbb -M:dev:render-html → build-time regenerate docs/samples/
  ;; operator-console.html through the real marketing actor
  ;; (marketing.render-html). Closes flagship checklist item 2 (ADR-2607189300).
  :render-html {:main-opts ["-m" "marketing.render-html"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
